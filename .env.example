# Reference values for IntelliJ Run Configuration environment variables.
# Spring Boot does not load this file automatically.
SERVER_PORT=8080

DB_URL=jdbc:mysql://localhost:3306/bakery_db?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=change-me

MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_FROM=your-email@gmail.com

UPLOAD_DIR=uploads
SESSION_TIMEOUT=30m
APP_LOG_LEVEL=DEBUG

BOOTSTRAP_ADMIN_ENABLED=true
ADMIN_EMAIL=admin@bakery.local
ADMIN_PASSWORD=admin123
ADMIN_NAME=Bakery Admin
